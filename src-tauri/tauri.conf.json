{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok News Studio Local",
  "version": "0.1.0",
  "identifier": "de.tiktoknewsstudio.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TikTok News Studio Local",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$RESOURCE/**", "$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI workflow studio for TikTok news production",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
